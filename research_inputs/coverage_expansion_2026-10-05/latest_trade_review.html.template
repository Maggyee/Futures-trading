dth:100%;font-size:14px}th,td{text-align:left;border-bottom:1px solid var(--line);padding:11px 10px;white-space:nowrap}th{font-size:12px;font-weight:500;color:var(--muted)}.num{text-align:right;font-variant-numeric:tabular-nums}.highlight{background:#edf6f3}button,select{font:inherit;color:var(--ink);background:white;border:1px solid #c8d4e1;border-radius:7px;padding:8px 10px;max-width:100%}button{cursor:pointer}button:hover{background:#edf4ff}button:disabled{opacity:.45;cursor:default}.controls label{display:flex;gap:8px;align-items:center}.controls{margin-bottom:18px}#trade{max-width:570px}#chart{width:100%;min-height:970px}#higher{width:100%;min-height:680px}.chart-stats{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:16px;margin:14px 0}.chart-stats strong{display:block;font-size:19px;white-space:nowrap}.chart-stats small{display:block}.legend-note{font-size:13px;color:var(--muted)}.diagram-note{display:flex;gap:15px;flex-wrap:wrap;margin:8px 0}details summary{cursor:pointer;font-weight:600;margin:6px 0}tr.trade-row{cursor:pointer}tr.trade-row:hover,tr.active{background:#edf4ff}.pill{font-size:12px;border-radius:4px;padding:3px 8px;background:#edf4ff;color:#375f92}.subtle{font-size:12px;color:var(--muted)}.check-list{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:10px}.check{padding:8px 11px;background:#f7fafc;border-radius:5px;font-size:13px}.pass{color:var(--green);font-weight:600}footer{font-size:12px;color:var(--muted);margin:25px 0}.narrow{max-width:1080px}.screenshots{display:flex;gap:16px;flex-wrap:wrap}.preview header,.preview .nav,.preview #overview,.preview #frequency,.preview #rules,.preview #improve,.preview #audit,.preview footer,.preview .controls,.preview #trade-list,.preview #higher-details{display:none}.preview main{margin:10px auto}.preview .card{margin:0}.preview #chart{min-height:970px}
