<html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>交易频率优化 · 对照结果与进出场图</title><style>
:root{--ink:#243447;--muted:#63748a;--blue:#2862b0;--green:#197b68;--red:#ad4233;--line:#dce4ec;--paper:#f3f6fa}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font:15px/1.7 "Noto Sans CJK SC","Microsoft YaHei",sans-serif}main{max-width:1460px;margin:32px auto;padding:0 24px}header{padding:12px 4px 8px}h1{font-size:34px;line-height:1.35;margin:10px 0 12px;letter-spacing:.01em}h2{font-size:23px;line-height:1.45;margin:0 0 12px}h3{font-size:17px;margin:8px 0}p{margin:8px 0}.eyebrow{color:var(--blue);font-size:12px;letter-spacing:.12em;font-weight:700}.lead{font-size:18px;max-width:1060px}.muted,small{color:var(--muted)}.tags,.nav,.controls{display:flex;flex-wrap:wrap;gap:10px;align-items:center}.tags{margin:16px 0}.tag{background:#eaf1f9;border:1px solid #cddcee;color:#3f5f83;padding:3px 9px;border-radius:5px;font-size:12px}.nav{margin:16px 0 24px;gap:24px}a{color:var(--blue);text-decoration:none}a:hover{text-decoration:underline}.card{background:white;border:1px solid var(--line);border-radius:13px;padding:23px;margin:19px 0;box-shadow:0 3px 15px #23334e05}.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin:18px 0}.stat{border-left:3px solid #c6d8e9;padding-left:14px}.stat small{display:block}.stat strong{font-size:29px;font-weight:650;line-height:1.6;display:block;font-variant-numeric:tabular-nums;white-space:nowrap}.positive{color:var(--green)}.negative{color:var(--red)}.note{background:#f3f7fb;border-radius:7px;padding:12px 15px;color:#566b80;font-size:13px}.callout{border-left:3px solid #cba254;background:#fff9eb;padding:14px 18px;border-radius:0 6px 6px 0;margin:16px 0}.twocol{display:grid;grid-template-columns:1fr 1fr;gap:18px}.box{border:1px solid var(--line);padding:16px;border-radius:8px;min-width:0}.table-wrap{overflow:auto;max-width:100%}.twocol>div{min-width:0}.plot-scroll{overflow-x:auto;max-width:100%}#chart,#higher{min-width:1000px}table{border-collapse:collapse;width:100%;font-size:14px}th,td{text-align:left;border-bottom:1px solid var(--line);padding:11px 10px;white-space:nowrap}th{font-size:12px;font-weight:500;color:var(--muted)}.num{text-align:right;font-variant-numeric:tabular-nums}.highlight{background:#edf6f3}button,select{font:inherit;color:var(--ink);background:white;border:1px solid #c8d4e1;border-radius:7px;padding:8px 10px;max-width:100%}button{cursor:pointer}button:hover{background:#edf4ff}button:disabled{opacity:.45;cursor:default}.controls label{display:flex;gap:8px;align-items:center}.controls{margin-bottom:18px}#trade{max-width:570px}#chart{width:100%;min-height:970px}#higher{width:100%;min-height:680px}.chart-stats{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:16px;margin:14px 0}.chart-stats strong{display:block;font-size:19px;white-space:nowrap}.chart-stats small{display:block}.legend-note{font-size:13px;color:var(--muted)}.diagram-note{display:flex;gap:15px;flex-wrap:wrap;margin:8px 0}details summary{cursor:pointer;font-weight:600;margin:6px 0}tr.trade-row{cursor:pointer}tr.trade-row:hover,tr.active{background:#edf4ff}.pill{font-size:12px;border-radius:4px;padding:3px 8px;background:#edf4ff;color:#375f92}.subtle{font-size:12px;color:var(--muted)}.check-list{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:10px}.check{padding:8px 11px;background:#f7fafc;border-radius:5px;font-size:13px}.pass{color:var(--green);font-weight:600}footer{font-size:12px;color:var(--muted);margin:25px 0}.narrow{max-width:1080px}.screenshots{display:flex;gap:16px;flex-wrap:wrap}.preview header,.preview .nav,.preview #overview,.preview #frequency,.preview #rules,.preview #improve,.preview #audit,.preview footer,.preview .controls,.preview #trade-list,.preview #higher-details{display:none}.preview main{margin:10px auto}.preview .card{margin:0}.preview #chart{min-height:970px}.preview #paired,.preview #blocked{display:none}
.stat strong{white-space:normal;font-size:23px}.controls label{min-width:0;max-width:100%}
@media(max-width:820px){main{padding:0 11px;margin:16px auto}h1{font-size:27px}.card{padding:15px}.stats{grid-template-columns:repeat(2,minmax(0,1fr));gap:17px}.stat strong{font-size:clamp(16px,4.6vw,25px)}.twocol,.check-list{grid-template-columns:1fr}.chart-stats{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.controls label{align-items:flex-start;flex-direction:column}#trade{max-width:100%}.controls{gap:10px}.controls label.wide{width:100%}.chart-stats strong{font-size:15px;white-space:normal}.nav{gap:13px;font-size:13px}#chart{min-height:970px}.lead{font-size:16px}}
