[Unit]
Description=Bounded verified quant research Google Drive backup
After=network-online.target sing-box.service
Wants=network-online.target

[Service]
Type=oneshot
User=nishiki
WorkingDirectory=/home/nishiki/vnpy-ctp
Environment=HTTP_PROXY=http://127.0.0.1:10808
Environment=HTTPS_PROXY=http://127.0.0.1:10808
Environment=ALL_PROXY=socks5://127.0.0.1:10808
Environment=RCLONE_CONFIG=/home/nishiki/.config/rclone/quant-googledrive.conf
ExecStart=/home/nishiki/vnpy-ctp/.venv/bin/python -m research.cloud_archive sync --policy /home/nishiki/vnpy-ctp/research_inputs/coverage_expansion_2026-10-05/cloud_policy.json
Nice=15
IOSchedulingClass=idle
CPUQuota=80%
MemoryMax=350M
TimeoutStartSec=45min
UMask=0077
