[Unit]
Description=CTP Workbench web API and backtest supervisor
After=network-online.target workbench-worker.service
Wants=workbench-worker.service

[Service]
Type=simple
User=nishiki
WorkingDirectory=/home/nishiki/vnpy-ctp
EnvironmentFile=/home/nishiki/vnpy-ctp/deploy/workbench.env
ExecStart=/home/nishiki/vnpy-ctp/.venv/bin/python -m backend.cli api
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/nishiki/vnpy-ctp/runtime

[Install]
WantedBy=multi-user.target
